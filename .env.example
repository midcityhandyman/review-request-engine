# All values are optional. The defaults below are used when a value is unset.
# No API keys are needed: the only sender shipped here is the offline mock.

# Hours to wait after a job closes before asking for a review.
REVIEW_DELAY_HOURS=2

# Quiet hours in local time (24h clock). No ask is sent inside this range.
# The range may wrap past midnight. Set both to the same value to disable.
QUIET_HOURS_START=20:00
QUIET_HOURS_END=09:00

# IANA time zone used for quiet hours and for report timestamps.
TIMEZONE=UTC

# A customer is asked at most once in this many days.
DEDUPE_WINDOW_DAYS=90

# Link placed in the review ask.
REVIEW_LINK=https://example.com/review

# Sender to use. Only "mock" exists in this repo.
SENDER=mock
